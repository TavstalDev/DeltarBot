<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- Naming -->
        <AssemblyName>DeltarBot</AssemblyName>
        <RootNamespace>Tavstal.DeltarBot</RootNamespace>
        <Product>DeltarBot</Product>
        <Company>Tavstal</Company>
        <Copyright>Copyright © 2026 Tavstal</Copyright>
        <Description>A basic zones plugin with database support.</Description>

        <!-- Version -->
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <BuildDate>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss"))</BuildDate>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <!-- Custom Metadata -->
    <ItemGroup>
        <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="Discord.Net" Version="3.20.1" />
      <PackageReference Include="Discord.Net.Commands" Version="3.20.1" />
      <PackageReference Include="Discord.Net.Interactions" Version="3.20.1" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update=".env">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    
    <ItemGroup>
      <None Remove="config.json" />
    </ItemGroup>
    
    <ItemGroup>
      <Reference Include="WynnNetSDK">
        <HintPath>..\assets\libs\WynnNetSDK.dll</HintPath>
      </Reference>
    </ItemGroup>

</Project>
